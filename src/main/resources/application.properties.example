# ==========================================================
# CONFIGURAÇÕES DE BANCO DE DADOS
# ==========================================================
# Altere 'NOME_DO_BANCO' para o nome que você criou no PostgreSQL (diferente do MySQL, o Postgres não cria o
# banco sozinho na primeira conexão - rode antes: createdb NOME_DO_BANCO, ou crie pela interface do seu cliente)
# Usuário e senha vêm das variáveis de ambiente DB_USERNAME e DB_PASSWORD - não coloque valores reais aqui
spring.datasource.url=jdbc:postgresql://localhost:5432/NOME_DO_BANCO
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# Configurações do Hibernate / JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# ==========================================================
# CREDENCIAIS DO ADMINISTRADOR (RAPHA)
# ==========================================================
# Estes valores serão usados pelo AdminSeeder para criar o acesso inicial - defina via ADMIN_EMAIL e ADMIN_PASSWORD
app.admin.email=${ADMIN_EMAIL}
app.admin.password=${ADMIN_PASSWORD}

# ==========================================================
# CONFIGURAÇÕES DE SEGURANÇA (JWT)
# ==========================================================
# Chave secreta para assinatura dos tokens - defina via variável de ambiente JWT_SECRET (gere com: openssl rand -base64 32)
# Sem valor default: a aplicação deve falhar ao iniciar se JWT_SECRET não estiver definida
api.security.token.secret=${JWT_SECRET}

# ==========================================================
# CORS
# ==========================================================
# Domínio(s) exatos do frontend em produção, separados por vírgula (ex: https://raphabarber.vercel.app)
cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:*}