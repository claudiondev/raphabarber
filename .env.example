# Copie este arquivo para ".env" (que já está no .gitignore) e preencha com valores reais.
# Usado pelo docker-compose.yml - nunca comite o .env de verdade.

# MySQL
MYSQL_ROOT_PASSWORD=root
DB_NAME=raphabarber
DB_USERNAME=raphabarber
DB_PASSWORD=raphabarber

# Segredo do JWT - gere com: openssl rand -base64 32
JWT_SECRET=

# Credenciais do admin (Rapha) criadas automaticamente no primeiro start
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Domínio(s) do frontend em produção, separados por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173
